{% extends 'base.html.twig' %}
{% block title %}Lista Pets{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Pets</h1>
        <form method="get" class="d-flex gap-2">
            {% set opts = ['available','pending','sold'] %}
            {% for s in opts %}
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="status[]" value="{{ s }}"
                           id="st_{{ s }}" {{ s in status ? 'checked' }}>
                    <label class="form-check-label" for="st_{{ s }}">{{ s|capitalize }}</label>
                </div>
            {% endfor %}
            <button class="btn btn-primary btn-sm">Filtruj</button>
        </form>
    </div>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Nazwa</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td>{{ row.id }}</td>
                <td>{{ row.name ?? '' }}</td>
                <td><span class="badge bg-secondary">{{ row.status }}</span></td>
                <td class="d-flex gap-2">
                    <a class="btn btn-outline-primary" href="{{ path('pet_upload', {id: row.id}) }}">Wyślij zdjęcie</a>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('pet_show', {id: row.id}) }}">Podgląd</a>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('pet_edit', {id: row.id}) }}">Edytuj</a>
                    <form method="post" action="{{ path('pet_delete', {id: row.id}) }}"
                          onsubmit="return confirm('Usunąć?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pet_' ~ row.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Usuń</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-muted">Brak danych.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
